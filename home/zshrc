# Path to Oh My Zsh (cloned by mise bootstrap, see ~/.config/mise/config.toml)
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.zsh-custom"

export EDITOR=nano
export VISUAL=nano

export PATH="$HOME/.local/bin:$PATH"

# Theme fallback (real prompt in $ZSH_CUSTOM/prompt.zsh)
ZSH_THEME="robbyrussell"

# OMZ plugins
# command-not-found comes from zsh/plugins.zsh, as on Kali; gcloud is not installed.
plugins=(git git-prompt docker kubectl aws debian pip python colored-man-pages virtualenv)

source $ZSH/oh-my-zsh.sh

# Load custom configs
for file in $ZSH_CUSTOM/*.zsh; do
  source "$file"
done

# mise: tools from ~/.config/mise/config.toml (gh, glab, terraform...)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
