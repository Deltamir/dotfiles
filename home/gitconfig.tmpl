# gh and glab come from mise: its shims directory has a stable path, unlike
# the versioned install directories (the old glab/1.79.0 path broke on upgrade).
[credential "https://github.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gitlab.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/glab auth git-credential

[color]
    diff = auto
    status = auto
    branch = auto

# Who you are (name, email) and per-employer settings (a company GitLab's
# credential helper...): from the identity repository. Last, so it wins; git
# skips a missing include, so a machine without identity still works.
# Before it, ~/.gitconfig.local: the Git user of a ~/.gitconfig found in place
# (VS Code copies the host's into devcontainers, which have no identity), kept
# by install.sh. Not versioned.
[include]
	path = ~/.gitconfig.local
[include]
	path = ~/.gitconfig.identity
