# Common Git settings, deployed as ~/.config/git/config (not ~/.gitconfig).
# ~/.gitconfig, read after this file, holds only [user]: install.sh writes the
# identity's there, and VS Code copies it into devcontainers, which have no
# identity. Nothing machine-specific goes there, so that copy works anywhere.
# gh and glab come from mise: its shims directory has a stable path, unlike
# the versioned install directories (the old glab/1.79.0 path broke on upgrade).
[credential "https://github.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gitlab.com"]
	helper =
	helper = !{{ env.HOME }}/.local/share/mise/shims/glab auth git-credential

[color]
    diff = auto
    status = auto
    branch = auto

# Per-employer settings (a company GitLab's credential helper...) and who you
# are: from the identity repository. Last, so it wins; git skips a missing
# include, so a machine without identity still works.
[include]
	path = ~/.gitconfig.identity
